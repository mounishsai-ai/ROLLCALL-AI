# ─── Firebase ────────────────────────────────────────────────
FIREBASE_CREDENTIALS_PATH=serviceAccountKey.json
KNOWN_FACES_DIR=known_faces

# ─── Recognition backend ─────────────────────────────────────
# "arcface" (DeepFace) or "adaface" (PyTorch IR-50)
# Only ONE is active per API process. Restart after changing.
FACE_RECOGNITION_BACKEND=adaface

# ─── Matching thresholds (shared by both backends) ───────────
DEEPFACE_MATCH_THRESHOLD=0.40
DEEPFACE_UNSURE_THRESHOLD=0.35
# NOTE: the code reads FACE_MATCH_MARGIN (not DEEPFACE_MATCH_MARGIN).
FACE_MATCH_MARGIN=0.05

# ─── AdaFace ─────────────────────────────────────────────────
ADAFACE_MODEL_PATH=pretrained/adaface_ir50_ms1mv2.ckpt
ADAFACE_ARCHITECTURE=ir_50

# ─── Gemini second opinion ───────────────────────────────────
# Two ways to reach Gemini. Vertex AI is tried first when VERTEX_PROJECT is
# set, and is strongly preferred: on the AI Studio free tier gemini-3.7-flash
# was measured returning "503 high demand" for minutes at a time, while the
# same model through Vertex on a billed project answered in 3.5s.
# Requires: gcloud auth application-default login
#           gcloud services enable aiplatform.googleapis.com
VERTEX_PROJECT=
VERTEX_LOCATION=global

# Fallback transport if VERTEX_PROJECT is empty. Free tier, heavily throttled.
GEMINI_API_KEY=

# Preferred model, then progressively lighter stand-ins tried in order if it
# is unavailable. A model that fails is skipped for the next couple of minutes
# rather than retried on every face.
VLM_MODEL_NAME=gemini-3.7-flash
VLM_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.1-flash-lite
VLM_UNHEALTHY_COOLDOWN_SECONDS=120

# Per-call caps. Identification sends several photos at once, so it is a
# heavier request than the two-image yes/no check and gets a longer budget.
VLM_TIMEOUT_SECONDS=20
VLM_IDENTIFY_TIMEOUT_SECONDS=30
VLM_MAX_WORKERS=5

# ─── Adjudicator (the agentic investigation loop) ────────────
# How many uncertain faces are worth investigating, best-scoring first.
ADJ_MAX_INVESTIGATIONS=8
# Total wall clock for the investigation phase, so a hard photo cannot turn a
# live demo into a three-minute wait. Detection is NOT charged to this — only
# the investigating that follows it.
ADJ_TIME_BUDGET_SECONDS=120
# Re-crops are always detected at this fixed size. Keep it constant: RetinaFace
# builds a TensorFlow graph per input shape, and a varying size pays that cost
# over and over.
ADJ_RESCAN_CANVAS_PX=384
# A face narrower than this many pixels gets re-cropped and re-measured before
# anything expensive is asked about it.
ADJ_MIN_FACE_PX=90
# Laplacian variance below this counts as out of focus.
ADJ_BLUR_THRESHOLD=60
# How many students are worth showing a vision model at once, and how far
# below the leader a candidate can score and still be a real contender.
ADJ_SHORTLIST_MAX=4
ADJ_SHORTLIST_RATIO=0.65
